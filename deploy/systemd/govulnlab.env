# /etc/govulnlab/govulnlab.env —— systemd EnvironmentFile
# 权限必须是 0640，属主 govulnlab；不要把真实口令提交到仓库。

GVL_DB_PASSWORD=change-me-please
GVL_APP_ENV=prod
GVL_LOG_FORMAT=json
GVL_LOG_LEVEL=info

# 生产环境务必关掉靶场；如果只是内网演示，保持 enabled=true 且 allow_remote=false
GVL_LAB_ENABLED=false

# 走 Nginx 反代时打开，才会信任 X-Forwarded-For 拿真实客户端 IP
GVL_SECURITY_TRUST_PROXY=true

# Cookie 只在 HTTPS 下发送
GVL_SESSION_SECURE=true
